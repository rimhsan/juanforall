rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------- Authentication & Basic Access ----------
    
    allow read, write: if request.auth != null;
    
    // ---------- Users Collection ----------
    // Users can read their own document; admins can read all user docs
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/users/$(userId)).data.isOfficial == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ---------- Announcements Collection ----------
    match /announcements/{announcementId} {
      // Anyone can read announcements
      allow read: if request.auth != null;
      // Only officials can create/update/delete
      allow create: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
      allow update: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
      allow delete: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
    }
    
    // ---------- Complaints Collection ----------
    match /complaints/{complaintId} {
      // Anyone can read complaints
      allow read: if request.auth != null;
      // Only officials can update status; creators can own their complaints
      allow create: if request.auth != null;
      allow update: if request.auth != null && (get(/users/$(request.auth.uid)).data.isOfficial == true || request.auth.uid == request.resource.data.complainantUid);
      allow delete: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
    }
    
    // ---------- Court Bookings Collection ----------
    match /courtBookings/{bookingId} {
      // Anyone can read bookings
      allow read: if request.auth != null;
      // Only officials can verify; owners can cancel their own
      allow create: if request.auth != null;
      allow update: if request.auth != null && (get(/users/$(request.auth.uid)).data.isOfficial == true || request.auth.uid == request.resource.data.userUid);
      allow delete: if request.auth != null && (get(/users/$(request.auth.uid)).data.isOfficial == true || request.auth.uid == request.resource.data.userUid);
    }
    
    // ---------- Summons Collection ----------
    match /summons/{summonId} {
      // Anyone can read summons
      allow read: if request.auth != null;
      // Only officials can create/update/cancel
      allow create: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
      allow update: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
      allow delete: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
    }
    
    // ---------- Residents Collection ----------
    match /residents/{residentId} {
      // Only officials can manage resident records
      allow read: if request.auth != null && (request.auth.uid == residentId || get(/users/$(request.auth.uid)).data.isOfficial == true);
      allow write: if request.auth != null && get(/users/$(request.auth.uid)).data.isOfficial == true;
    }
  }
}